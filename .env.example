# Snowflake credentials (required for snowflake mode)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FINANCIAL_RAG_WH
SNOWFLAKE_DATABASE=FINANCIAL_RAG
SNOWFLAKE_SCHEMA=PUBLIC

# App mode: 'demo' (local files) or 'snowflake' (Snowflake backend)
APP_MODE=demo

# Claude API key (optional - enables AI-powered responses)
# Get one at: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key
